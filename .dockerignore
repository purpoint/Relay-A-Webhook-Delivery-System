# `node_modules` alone matches only the top level, so web/node_modules would
# otherwise be copied into the build context — slow, and wrong, since the
# image installs its own with `npm ci`.
**/node_modules

dist

# Generated inside the image by the web build. A stale local copy must not be
# able to end up in the context and mask a broken build.
public

coverage
.git
.gitignore
.env
.env.*
!.env.example
src/generated
docs
*.md
.claude
.github
tests
scripts
Screenshot*.png
