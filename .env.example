# Copy to .env and fill in. Every variable here is validated at boot by
# src/config/env.ts — a missing or malformed value fails startup immediately
# rather than surfacing as a runtime error later.

NODE_ENV=development
LOG_LEVEL=debug

# ── API server ──────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Datastores ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER@localhost:5432/relay?schema=public"
# Should comfortably exceed WORKER_CONCURRENCY, or workers end up queueing on
# connection acquisition instead of delivering webhooks.
DATABASE_POOL_SIZE=15

REDIS_URL="redis://localhost:6379"

# ── Auth ────────────────────────────────────────────────────────────────────
# Management-token signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=1h

# ── Webhook URL policy ──────────────────────────────────────────────────────
# Allow webhook URLs pointing at loopback/private IPs. MUST be false in
# production — enabling it lets customers aim our workers at internal
# services or the cloud metadata endpoint (SSRF). The server refuses to boot
# if this is true while NODE_ENV=production.
ALLOW_PRIVATE_WEBHOOK_URLS=false
REQUIRE_HTTPS_WEBHOOKS=true

# ── Execution window ────────────────────────────────────────────────────────
# The hard cap on delivery jobs resident in Redis at any moment. Postgres holds
# everything else. This is the number the whole architecture exists to bound.
EXECUTION_WINDOW_SIZE=5000
SCHEDULER_POLL_MS=2000

# Age at which a delivery stuck in PROCESSING is presumed abandoned by a dead
# worker and returned to WAITING by the scheduler's reaper.
LEASE_TIMEOUT_MS=60000

# ── Workers ─────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=10
MAX_ATTEMPTS=8
DELIVERY_TIMEOUT_MS=10000

# Exponential backoff between retry attempts, with full jitter applied.
RETRY_BASE_MS=5000
RETRY_MAX_MS=3600000
