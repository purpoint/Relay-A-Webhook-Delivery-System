{
  "name": "relay",
  "version": "0.1.0",
  "description": "A webhook delivery platform with durable event storage and a bounded Redis execution window",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:scheduler": "tsx watch src/scheduler/main.ts",
    "dev:worker": "tsx watch src/workers/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:scheduler": "node dist/scheduler/main.js",
    "start:worker": "node dist/workers/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "receiver": "node scripts/receiver.mjs",
    "load-test": "node scripts/load-test.mjs"
  },
  "keywords": [
    "webhooks",
    "delivery",
    "queue",
    "fastify",
    "distributed-systems"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "fastify": "^5.11.3",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
